# BridgEd Backend - Environment Variables Example
# Copy this file to .env and fill in your actual values.

# --- Django Settings ---
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database Configuration
DATABASE_NAME=your-database-name
DATABASE_USER=your-database-user
DATABASE_PASSWORD=your-database-password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# --- Matching Engine & Scheduler ---
MATCHING_SCHEDULER_ENABLED=True

# --- LLM Parsing (Hugging Face / Ollama) ---
# Set USE_LLM_PARSER=True to enable CV structuring via AI.
USE_LLM_PARSER=True

# --- Security & Origin Settings ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Default: Hugging Face
LLM_BASE_URL=https://router.huggingface.co/v1
LLM_API_KEY=your-huggingface-api-key-here
LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Alternative: Local Ollama (No API key required)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1:8b

# --- Supabase Storage (Resumes & Profile Photos) ---
SUPABASE_URL=your-supabase-project-url
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET_RESUMES=your-resumes-bucket-name
SUPABASE_BUCKET_PROFILE_IMAGES=your-profile-images-bucket-name

# --- Payments (Paystack) ---
PAYSTACK_SECRET_KEY=your-paystack-test-secret-key
